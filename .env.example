NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medivault
DATABASE_SSL=false
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
AWS_REGION=ap-south-1
S3_MEDICAL_RECORDS_BUCKET=medivault-medical-records
# Base64-encoded 32-byte key. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FILE_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Dedicated backend wallet that owns the deployed MediVaultRecordRegistry contract.
BLOCKCHAIN_PRIVATE_KEY=0xyour_private_key
